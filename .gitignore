# ---------------------------------------------------------------- secrets
# Local DB credentials (copy includes/config.sample.php -> includes/config.php)
includes/config.php

# schema.sql seeds live Twilio and Google Maps API keys straight into the
# settings table, so it must never be published. The SEO files next to it are
# page content only — no credentials — and are tracked so that deployments can
# import them (verified: no key patterns in either file).
sql/schema.sql
sql/*.dump
*.sql.gz
!sql/seo.sql
!sql/seo-seed.sql

# Anything else that carries credentials
.env
.env.*
*.pem
*.key
credentials*.json

# ------------------------------------------------------- generated content
# Admin uploads (recreated at runtime; assets/img/ IS tracked)
assets/uploads/

# ---------------------------------------------------------- staging assets
# 34 MB of original logo drafts / RTF copy — not code, not served.
# Delete this line if you want the source artwork version-controlled.
HelpingFiles/

# ------------------------------------------------------------ logs & junk
*.log
error_log
php_errors.log
.DS_Store
._*
Thumbs.db
*.swp
*~
.idea/
.vscode/
.cache/
