# Worldwide Handyman — clean URLs, SEO routes, compression and caching
#
# Clean URL mappings remain available for existing bookmarks and indexed URLs.
# Public page links themselves use real PHP endpoints so the site also works on
# hosting that does not enable per-directory rewrite rules.
#
# The admin panel keeps its .php URLs — it is private, so there is nothing to
# gain from rewriting it, and leaving it alone keeps its links working as-is.

# Proves to PHP that this file is being read at all. clean_urls_enabled()
# and _wwh-diag.php both look for it.
<IfModule mod_env.c>
    SetEnv WWH_HTACCESS 1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Tells PHP that rewrite rules really are running, so it is safe to emit
    # clean keyword URLs (/handyman/toronto) instead of falling back to
    # /location.php?slug=toronto. Do not remove — see clean_urls_enabled().
    RewriteRule ^ - [E=WWH_CLEAN_URLS:1]

    # ---------------------------------------------------- crawler files
    RewriteRule ^robots\.txt$   robots.php  [L]
    RewriteRule ^sitemap\.xml$  sitemap.php [L]
    RewriteRule ^sitemap-([a-z0-9-]+)\.xml$ sitemap.php?section=$1 [L,QSA]

    # ------------------------------------------------------ SEO routes
    # /handyman/north-york                -> location landing page
    RewriteRule ^handyman/([a-z0-9-]+)/?$ location.php?slug=$1 [L,QSA]

    # /services/tv-mounting/north-york    -> service x city landing page
    RewriteRule ^services/([a-z0-9-]+)/([a-z0-9-]+)/?$ service-location.php?service=$1&location=$2 [L,QSA]

    # /services/tv-mounting               -> service landing page
    RewriteRule ^services/([a-z0-9-]+)/?$ service.php?slug=$1 [L,QSA]

    # ------------------------------------------------ extensionless PHP
    # /about -> about.php                (internal rewrite, URL stays clean)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    # --------------------------------------------------------- 404 page
    # Anything left over gets the styled 404 (with a real 404 status), except
    # the admin panel and static asset requests, which Apache handles itself.
    RewriteCond %{REQUEST_URI} !/admin/
    RewriteCond %{REQUEST_URI} !\.(?:js|css|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|map|txt|xml|pdf|mp4|webm)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

# ------------------------------------------------------------ compression
# Smaller responses load faster, and page speed is a ranking input.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml application/vnd.ms-fontobject font/ttf font/otf
</IfModule>

# ---------------------------------------------------------- browser cache
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg        "access plus 1 year"
    ExpiresByType image/png         "access plus 1 year"
    ExpiresByType image/webp        "access plus 1 year"
    ExpiresByType image/gif         "access plus 1 year"
    ExpiresByType image/svg+xml     "access plus 1 year"
    ExpiresByType image/x-icon      "access plus 1 year"
    ExpiresByType font/woff2        "access plus 1 year"
    # CSS and JS are cache-busted with ?v=filemtime, so a long TTL is safe
    ExpiresByType text/css          "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/html         "access plus 0 seconds"
    ExpiresByType application/xml   "access plus 0 seconds"
</IfModule>

# --------------------------------------------------------------- headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # Never let a crawler index the admin panel, even if it finds a link
    <FilesMatch "\.(php)$">
        Header always set X-Robots-Tag "noindex, nofollow" "expr=%{REQUEST_URI} =~ m#/admin/#"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------ hardening
# Block direct access to config, SQL dumps and dotfiles
<FilesMatch "^(config\.php|config\.sample\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
<FilesMatch "\.(sql|md|json|lock|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

Options -Indexes
